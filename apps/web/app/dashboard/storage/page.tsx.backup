'use client';

import { useState, useEffect } from 'react';
import { PageHeader, Badge } from '../../../components/ui';

function formatBytes(b: number) {
  if (b < 1024) return { value: b.toFixed(0), unit: 'o' };
  if (b < 1024 * 1024) return { value: (b / 1024).toFixed(1), unit: 'Ko' };
  return { value: (b / 1024 / 1024).toFixed(2), unit: 'Mo' };
}

function humanSize(mo: number) {
  if (mo < 0.001) {
    const o = Math.round(mo * 1024 * 1024);
    return { value: o.toString(), unit: 'o' };
  }
  if (mo < 1) {
    const ko = mo * 1024;
    return { value: ko.toFixed(1), unit: 'Ko' };
  }
  return { value: mo.toFixed(2), unit: 'Mo' };
}

export default function StoragePage() {
  const [quotas, setQuotas] = useState<any[]>([]);
  const [backups, setBackups] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [backupMessage, setBackupMessage] = useState<string | null>(null);

  const token = typeof window !== 'undefined' ? localStorage.getItem('token') : '';

  async function load() {
    const [qRes, bRes] = await Promise.all([
      fetch('/api/storage', { headers: { Authorization: `Bearer ${token}` } }),
      fetch('/api/storage/backups', { headers: { Authorization: `Bearer ${token}` } }),
    ]);
    const [q, b] = await Promise.all([qRes.json(), bRes.json()]);
    setQuotas(Array.isArray(q) ? q : []);
    setBackups(Array.isArray(b) ? b : []);
  }

  useEffect(() => {
    load().catch(console.error).finally(() => setLoading(false));
  }, []);

  async function recordBackup(orgId: string, orgName: string) {
    setBackupMessage(null);
    const res = await fetch(`/api/storage/organization/${orgId}/backup`, {
      method: 'PATCH',
      headers: { Authorization: `Bearer ${token}` },
    });
    if (res.ok) {
      setBackupMessage(`✅ Sauvegarde déclenchée pour ${orgName}`);
      await load();
      setTimeout(() => setBackupMessage(null), 3000);
    }
  }

  async function downloadBackup(id: string) {
    const res = await fetch(`/api/storage/backup/${id}/download`, { headers: { Authorization: `Bearer ${token}` } });
    if (!res.ok) { alert('Erreur de téléchargement'); return; }
    const disposition = res.headers.get('Content-Disposition') || '';
    const match = disposition.match(/filename="([^"]+)"/);
    const fileName = match ? match[1] : `backup-${id}.sql`;
    const blob = await res.blob();
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = fileName;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    window.URL.revokeObjectURL(url);
  }

  if (loading) return <div className="flex justify-center items-center h-64">Chargement...</div>;

  return (
    <div className="space-y-6">
      <PageHeader
        title="Stockage & Sauvegardes"
        subtitle="Les quotas sont configurés automatiquement selon l'abonnement"
      />

      {backupMessage && (
        <div className="p-4 bg-blue-50 border border-blue-200 rounded-xl text-blue-700 text-sm">{backupMessage}</div>
      )}

      {/* Quotas */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {quotas.map((q) => {
          const used = q.usedStorage || 0;
          const max = q.maxStorage || 0;
          const pct = max > 0 ? Math.min(100, Math.round((used / max) * 100)) : 0;
          const remaining = Math.max(0, max - used);
          return (
            <div key={q.id} className="bg-white rounded-2xl p-5 shadow-sm border border-gray-200">
              <div className="flex items-center justify-between mb-4">
                <h3 className="font-bold text-slate-900">{q.organization?.name}</h3>
                <Badge variant="info">Quota</Badge>
              </div>

              <div className="bg-slate-50 rounded-xl p-4 mb-4">
                <div className="flex items-baseline justify-between mb-2">
                  <span className="text-xs font-semibold text-slate-500 uppercase">Stockage utilisé</span>
                  <span className="text-xs font-bold text-slate-700">{pct}%</span>
                </div>
                {(() => {
                  const h = humanSize(used);
                  return (
                    <>
                      <div className="flex items-baseline gap-1 mb-1">
                        <span className="text-2xl font-bold text-slate-900">{h.value}</span>
                        <span className="text-sm text-slate-500">{h.unit}</span>
                        <span className="text-sm text-slate-400 ml-1">/ {max} Mo</span>
                      </div>
                      <div className="text-[10px] text-slate-400 font-mono mb-3">
                        ≈ {Math.round(used * 1024 * 1024).toLocaleString('fr-FR')} octets · {(used * 1024).toFixed(2)} Ko · {used.toFixed(4)} Mo
                      </div>
                    </>
                  );
                })()}
                <div className="w-full h-3 bg-slate-200 rounded-full overflow-hidden">
                  <div className="h-full bg-linear-to-r from-blue-500 to-teal-400 rounded-full transition-all" style={{ width: pct > 0 ? `${pct}%` : '4px', minWidth: '4px' }}></div>
                </div>
                <p className="text-xs text-slate-500 mt-2">Reste : <span className="font-semibold text-slate-700">{remaining.toFixed(2)} Mo</span></p>
              </div>

              <p className="text-xs text-slate-500 mb-4">
                Dernière sauvegarde : {q.lastBackup ? `${new Date(q.lastBackup).toLocaleDateString('fr-FR')} à ${new Date(q.lastBackup).toLocaleTimeString('fr-FR')}` : 'Jamais'}
              </p>

              <button onClick={() => recordBackup(q.organizationId, q.organization?.name)} className="w-full py-2 bg-teal-50 text-teal-700 rounded-xl font-medium hover:bg-teal-100 transition text-sm">
                💾 Sauvegarder maintenant
              </button>
            </div>
          );
        })}
        {quotas.length === 0 && <div className="col-span-full text-center py-10 text-slate-400">Aucun quota configuré</div>}
      </div>

      {/* Backups */}
      <div className="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div className="px-5 py-4 border-b border-gray-100">
          <h3 className="font-semibold text-slate-900">Historique des sauvegardes</h3>
        </div>
        <div className="overflow-x-auto">
          <table className="w-full text-left text-sm">
            <thead className="bg-slate-50 border-b border-gray-200">
              <tr>
                <th className="p-4 font-semibold text-slate-600">Organisation</th>
                <th className="p-4 font-semibold text-slate-600">Fichier</th>
                <th className="p-4 font-semibold text-slate-600 text-right">Taille</th>
                <th className="p-4 font-semibold text-slate-600">Date</th>
                <th className="p-4 font-semibold text-slate-600">Statut</th>
                <th className="p-4 font-semibold text-slate-600 text-center">Actions</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-gray-100">
              {backups.map((b) => (
                <tr key={b.id} className="hover:bg-teal-50/40 transition">
                  <td className="p-4 font-medium text-slate-900">{b.organization?.name}</td>
                  <td className="p-4 text-slate-600 font-mono text-xs">{b.fileName}</td>
                  {(() => {
                  const sz = formatBytes(b.fileSize);
                  return <td className="p-4 text-right text-slate-600">{sz.value} <span className="text-xs text-slate-400">{sz.unit}</span></td>;
                })()}
                  <td className="p-4 text-slate-500 text-xs">{new Date(b.createdAt).toLocaleString('fr-FR')}</td>
                  <td className="p-4"><Badge variant="success">{b.status}</Badge></td>
                  <td className="p-4 text-center">
                    <button onClick={() => downloadBackup(b.id)} className="text-blue-600 hover:underline text-sm">Télécharger</button>
                  </td>
                </tr>
              ))}
              {backups.length === 0 && (
                <tr><td colSpan={6} className="p-8 text-center text-slate-400">Aucune sauvegarde</td></tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}
