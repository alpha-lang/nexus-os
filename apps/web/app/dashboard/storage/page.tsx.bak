'use client';

import { useState, useEffect } from 'react';

export default function StoragePage() {
  const [quotas, setQuotas] = useState<any[]>([]);
  const [backups, setBackups] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [backupMessage, setBackupMessage] = useState<string | null>(null);
  const [downloadInfo, setDownloadInfo] = useState<any>(null);

  useEffect(() => {
    const token = localStorage.getItem('token');
    Promise.all([
      fetch('/api/storage', { headers: { Authorization: `Bearer ${token}` } }),
      fetch('/api/storage/backups', { headers: { Authorization: `Bearer ${token}` } }),
    ])
      .then(([quotasRes, backupsRes]) => Promise.all([quotasRes.json(), backupsRes.json()]))
      .then(([quotas, backups]) => {
        setQuotas(Array.isArray(quotas) ? quotas : []);
        setBackups(Array.isArray(backups) ? backups : []);
      })
      .catch(console.error)
      .finally(() => setLoading(false));
  }, []);

  async function recordBackup(organizationId: string, organizationName: string) {
    setBackupMessage(null);
    const token = localStorage.getItem('token');
    const res = await fetch(`/api/storage/organization/${organizationId}/backup`, {
      method: 'PATCH',
      headers: { Authorization: `Bearer ${token}` },
    });
    if (res.ok) {
      setBackupMessage(`✅ Sauvegarde déclenchée pour ${organizationName}`);
      const backupsRes = await fetch('/api/storage/backups', { headers: { Authorization: `Bearer ${token}` } });
      const backupsData = await backupsRes.json();
      if (Array.isArray(backupsData)) setBackups(backupsData);

      const quotasRes = await fetch('/api/storage', { headers: { Authorization: `Bearer ${token}` } });
      const quotasData = await quotasRes.json();
      if (Array.isArray(quotasData)) setQuotas(quotasData);

      setTimeout(() => setBackupMessage(null), 3000);
    } else {
      setBackupMessage('❌ Erreur lors de la sauvegarde');
      setTimeout(() => setBackupMessage(null), 3000);
    }
  }

  async function downloadBackup(id: string) {
    const token = localStorage.getItem('token');
    const res = await fetch(`/api/storage/backup/${id}/download`, { headers: { Authorization: `Bearer ${token}` } });
    const data = await res.json();
    setDownloadInfo(data);
  }

  if (loading) return <div className="flex justify-center items-center h-64">Chargement...</div>;

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-2xl font-bold text-slate-900">Stockage & Sauvegardes</h1>
        <p className="text-slate-500 mt-1">Les quotas sont configurés automatiquement selon l'abonnement. Gérez ici les sauvegardes.</p>
      </div>

      {backupMessage && (
        <div className="p-4 bg-blue-50 border border-blue-200 rounded-xl text-blue-700 text-sm">{backupMessage}</div>
      )}

      {/* Quotas */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {quotas.map((quota) => {
          const used = quota.usedStorage || 0;
          const max = quota.maxStorage || 0;
          const usedPercent = max > 0 ? Math.min(100, Math.round((used / max) * 100)) : 0;
          const remaining = Math.max(0, max - used);

          return (
            <div key={quota.id} className="bg-white rounded-2xl p-5 shadow-sm border border-gray-200">
              <div className="flex items-center justify-between mb-4">
                <h3 className="font-bold text-slate-900">{quota.organization?.name}</h3>
                <span className="text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded-full">Quota</span>
              </div>

              {/* Bloc quota bien visible */}
              <div className="bg-slate-50 rounded-xl p-4 mb-4">
                <div className="flex items-baseline justify-between mb-2">
                  <span className="text-xs font-semibold text-slate-500 uppercase">Stockage utilisé</span>
                  <span className="text-xs font-bold text-slate-700">{usedPercent}%</span>
                </div>

                <div className="flex items-baseline gap-1 mb-3">
                  <span className="text-2xl font-bold text-slate-900">{used.toFixed(2)}</span>
                  <span className="text-sm text-slate-500">Mo</span>
                  <span className="text-sm text-slate-400 ml-1">/ {max} Mo</span>
                </div>

                {/* Barre toujours visible */}
                <div className="w-full h-3 bg-slate-200 rounded-full overflow-hidden">
                  <div
                    className="h-full bg-gradient-to-r from-blue-500 to-teal-400 rounded-full transition-all"
                    style={{ width: usedPercent > 0 ? `${usedPercent}%` : '4px', minWidth: '4px' }}
                  ></div>
                </div>

                <p className="text-xs text-slate-500 mt-2">
                  Reste : <span className="font-semibold text-slate-700">{remaining.toFixed(2)} Mo</span>
                </p>
              </div>

              <p className="text-xs text-slate-500">
                Dernière sauvegarde :{' '}
                {quota.lastBackup
                  ? `${new Date(quota.lastBackup).toLocaleDateString('fr-FR')} à ${new Date(quota.lastBackup).toLocaleTimeString('fr-FR')}`
                  : 'Jamais'}
              </p>

              <button
                onClick={() => recordBackup(quota.organizationId, quota.organization?.name)}
                className="mt-4 w-full py-2 bg-teal-50 text-teal-700 rounded-xl font-medium hover:bg-teal-100 transition text-sm"
              >
                💾 Sauvegarder maintenant
              </button>
            </div>
          );
        })}
        {quotas.length === 0 && (
          <div className="col-span-full text-center py-10 text-slate-400">Aucun quota configuré</div>
        )}
      </div>

      {/* Liste des sauvegardes */}
      <div className="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div className="px-5 py-4 border-b border-gray-100">
          <h3 className="font-semibold text-slate-900">Historique des sauvegardes</h3>
          <p className="text-sm text-slate-500 mt-1">Toutes les sauvegardes effectuées, avec possibilité de téléchargement</p>
        </div>
        <div className="overflow-x-auto">
          <table className="w-full text-left">
            <thead className="bg-slate-50 border-b border-gray-200">
              <tr>
                <th className="p-4 text-sm font-semibold text-slate-600">Organisation</th>
                <th className="p-4 text-sm font-semibold text-slate-600">Fichier</th>
                <th className="p-4 text-sm font-semibold text-slate-600">Taille</th>
                <th className="p-4 text-sm font-semibold text-slate-600">Date</th>
                <th className="p-4 text-sm font-semibold text-slate-600">Statut</th>
                <th className="p-4 text-sm font-semibold text-slate-600">Actions</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-gray-100">
              {backups.map((backup) => (
                <tr key={backup.id} className="hover:bg-slate-50 transition">
                  <td className="p-4 text-sm font-medium text-slate-900">{backup.organization?.name}</td>
                  <td className="p-4 text-sm text-slate-600">{backup.fileName}</td>
                  <td className="p-4 text-sm text-slate-600">{backup.fileSize.toFixed(2)} Mo</td>
                  <td className="p-4 text-sm text-slate-500">{new Date(backup.createdAt).toLocaleDateString('fr-FR')} à {new Date(backup.createdAt).toLocaleTimeString('fr-FR')}</td>
                  <td className="p-4 text-sm"><span className="px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">{backup.status}</span></td>
                  <td className="p-4 text-sm">
                    <button onClick={() => downloadBackup(backup.id)} className="text-blue-600 hover:underline">Télécharger</button>
                  </td>
                </tr>
              ))}
              {backups.length === 0 && (
                <tr><td colSpan={6} className="p-8 text-center text-slate-400">Aucune sauvegarde pour le moment</td></tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

      {/* Modale de succès */}
      {downloadInfo && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4">
          <div className="absolute inset-0 bg-black/60 backdrop-blur-sm" onClick={() => setDownloadInfo(null)}></div>
          <div className="relative bg-white rounded-2xl shadow-2xl w-full max-w-sm p-6 text-center">
            <div className="mx-auto w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
              <svg className="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 className="text-lg font-bold text-slate-900">Téléchargement prêt</h3>
            <p className="text-sm text-slate-500 mt-2 mb-6">
              {downloadInfo.message} - {downloadInfo.fileName}
            </p>
            <button
              onClick={() => setDownloadInfo(null)}
              className="w-full py-2.5 bg-green-600 text-white rounded-xl font-semibold hover:bg-green-700 transition"
            >
              OK
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
