'use client';

import { useState, useEffect } from 'react';

export default function FoliosPage() {
  const [folios, setFolios] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [selected, setSelected] = useState<any>(null);
  const [showAddCharge, setShowAddCharge] = useState(false);
  const [showPayment, setShowPayment] = useState(false);
  const [showCheckout, setShowCheckout] = useState(false);
  const [search, setSearch] = useState('');
  const [filter, setFilter] = useState<'ALL' | 'DUE' | 'PAID'>('ALL');
  const [sortBy, setSortBy] = useState<'ROOM' | 'DUE' | 'CHECKOUT'>('ROOM');

  // Form charge
  const [description, setDescription] = useState('');
  const [category, setCategory] = useState('OTHER');
  const [quantity, setQuantity] = useState('1');
  const [unitPrice, setUnitPrice] = useState('');

  // Form paiement
  const [payAmount, setPayAmount] = useState('');
  const [payMethod, setPayMethod] = useState('CASH');

  const token = typeof window !== 'undefined' ? localStorage.getItem('token') : '';
  const headers = { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' };

  async function load() {
    const res = await fetch('/api/pos/folios', { headers });
    const data = await res.json();
    setFolios(Array.isArray(data) ? data : []);
  }

  useEffect(() => {
    load().catch(console.error).finally(() => setLoading(false));
  }, []);

  async function reloadSelected(reservationId: string) {
    const res = await fetch('/api/pos/folios', { headers });
    const data = await res.json();
    const updated = (data || []).find((f: any) => f.reservationId === reservationId);
    setSelected(updated);
  }

  async function addCharge(e: React.FormEvent) {
    e.preventDefault();
    if (!selected) return;
    await fetch(`/api/pos/folios/${selected.reservationId}/charges`, {
      method: 'POST',
      headers,
      body: JSON.stringify({
        description,
        category,
        quantity: parseInt(quantity),
        unitPrice: parseFloat(unitPrice),
      }),
    });
    setShowAddCharge(false);
    setDescription('');
    setQuantity('1');
    setUnitPrice('');
    await load();
    await reloadSelected(selected.reservationId);
  }

  async function removeCharge(chargeId: string) {
    if (!confirm('Supprimer cet extra ?')) return;
    await fetch(`/api/pos/folios/charges/${chargeId}`, { method: 'DELETE', headers });
    await load();
    await reloadSelected(selected.reservationId);
  }

  async function closeFolio(e: React.FormEvent) {
    e.preventDefault();
    if (!selected) return;
    await fetch(`/api/pos/folios/${selected.reservationId}/close`, {
      method: 'POST',
      headers,
      body: JSON.stringify({
        amount: parseFloat(payAmount) || selected.solde,
        method: payMethod,
      }),
    });
    setShowPayment(false);
    setPayAmount('');
    await load();
    setSelected(null);
  }

  async function checkoutFolio(e: React.FormEvent) {
    e.preventDefault();
    if (!selected) return;
    await fetch(`/api/pos/folios/${selected.reservationId}/checkout`, {
      method: 'POST',
      headers,
      body: JSON.stringify({ method: payMethod }),
    });
    setShowCheckout(false);
    setPayAmount('');
    setSelected(null);
    await load();
  }

  // Filtrage + tri
  const filteredFolios = folios
    .filter((f) => {
      // Filtre recherche
      if (search.trim()) {
        const q = search.toLowerCase();
        const name = (f.customer?.firstName + ' ' + f.customer?.lastName).toLowerCase();
        const room = String(f.room?.number || '').toLowerCase();
        const ref = (f.reference || '').toLowerCase();
        if (!name.includes(q) && !room.includes(q) && !ref.includes(q)) return false;
      }
      // Filtre statut
      if (filter === 'DUE' && f.solde <= 0) return false;
      if (filter === 'PAID' && f.solde > 0) return false;
      return true;
    })
    .sort((a, b) => {
      if (sortBy === 'ROOM') return String(a.room?.number || '').localeCompare(String(b.room?.number || ''), undefined, { numeric: true });
      if (sortBy === 'DUE') return b.solde - a.solde;
      if (sortBy === 'CHECKOUT') return new Date(a.checkOutDate).getTime() - new Date(b.checkOutDate).getTime();
      return 0;
    });

  const stats = {
    total: folios.length,
    due: folios.filter((f) => f.solde > 0).length,
    paid: folios.filter((f) => f.solde <= 0).length,
    totalDue: folios.reduce((s, f) => s + (f.solde > 0 ? f.solde : 0), 0),
  };

  if (loading) return <div className="flex justify-center items-center h-64">Chargement...</div>;

  return (
    <div className="space-y-4">
      {/* Header */}
      <div className="bg-linear-to-r from-slate-900 to-blue-900 rounded-2xl px-5 py-4 text-white shadow-lg">
        <div className="flex items-center justify-between flex-wrap gap-3 mb-3">
          <div>
            <h1 className="text-lg font-bold">Folios clients</h1>
            <p className="text-xs text-blue-200 mt-0.5">
              {stats.total} client{stats.total > 1 ? 's' : ''} en séjour • <span className="text-red-300 font-bold">{stats.due} à payer</span> • <span className="text-green-300 font-bold">{stats.paid} à jour</span>
            </p>
          </div>
          <div className="flex gap-2">
            {stats.totalDue > 0 && (
              <div className="bg-red-500/20 border border-red-400/40 rounded-lg px-3 py-1.5 text-center">
                <p className="text-[9px] text-red-200 uppercase font-bold">Total à recouvrer</p>
                <p className="text-sm font-black text-red-100">{stats.totalDue.toLocaleString('fr-FR')} Ar</p>
              </div>
            )}
            <a href="/dashboard/caisse" className="bg-white/10 hover:bg-white/20 rounded-lg px-3 py-1.5 text-xs font-semibold border border-white/20 transition self-center">
              ← Retour caisse
            </a>
          </div>
        </div>

        {/* Barre de recherche + filtres + tri */}
        <div className="flex flex-wrap gap-2 items-center">
          <div className="relative flex-1 min-w-50">
            <span className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
              <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </span>
            <input
              type="text"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              placeholder="Rechercher chambre, nom, référence..."
              className="w-full pl-9 pr-3 py-2 bg-white/10 border border-white/20 rounded-lg text-white placeholder-blue-200 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:bg-white/20 transition"
            />
            {search && (
              <button onClick={() => setSearch('')} className="absolute inset-y-0 right-0 pr-3 flex items-center text-white/60 hover:text-white">
                ✕
              </button>
            )}
          </div>

          <div className="flex gap-1 bg-white/10 rounded-lg p-1 border border-white/20">
            {[
              { v: 'ALL' as const, l: 'Tous', c: stats.total },
              { v: 'DUE' as const, l: 'À payer', c: stats.due },
              { v: 'PAID' as const, l: 'À jour', c: stats.paid },
            ].map((f) => (
              <button
                key={f.v}
                onClick={() => setFilter(f.v)}
                className={`px-3 py-1.5 rounded-md text-xs font-bold transition ${
                  filter === f.v ? 'bg-white text-slate-900 shadow' : 'text-white hover:bg-white/10'
                }`}
              >
                {f.l} <span className="opacity-70">({f.c})</span>
              </button>
            ))}
          </div>

          <select
            value={sortBy}
            onChange={(e) => setSortBy(e.target.value as any)}
            className="px-3 py-2 bg-white/10 border border-white/20 rounded-lg text-white text-xs font-bold focus:outline-none focus:ring-2 focus:ring-teal-400 cursor-pointer"
          >
            <option value="ROOM" className="text-slate-900">Trier : N° chambre</option>
            <option value="DUE" className="text-slate-900">Trier : Reste dû</option>
            <option value="CHECKOUT" className="text-slate-900">Trier : Départ proche</option>
          </select>
        </div>
      </div>

      {filteredFolios.length === 0 ? (
        <div className="text-center py-16 bg-white rounded-2xl border">
          <div className="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center text-3xl mx-auto mb-3">📋</div>
          <p className="text-slate-500 font-medium">Aucun client en séjour</p>
        </div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {filteredFolios.map((f) => (
            <button
              key={f.reservationId}
              onClick={() => setSelected(f)}
              className="text-left bg-white rounded-2xl border-2 border-slate-200 p-5 hover:border-teal-400 hover:shadow-xl transition"
            >
              <div className="flex items-start justify-between mb-3">
                <div className="flex items-center gap-3">
                  <div className="w-12 h-12 bg-linear-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center text-white font-black text-lg shadow-md">
                    {f.room?.number}
                  </div>
                  <div>
                    <div className="font-bold text-slate-900 text-sm">
                      {f.customer?.firstName} {f.customer?.lastName}
                    </div>
                    <div className="text-[10px] text-slate-500 font-mono">{f.reference}</div>
                  </div>
                </div>
                {f.solde > 0 ? (
                  <span className="text-[10px] bg-red-100 text-red-700 px-2 py-1 rounded font-bold">À PAYER</span>
                ) : (
                  <span className="text-[10px] bg-green-100 text-green-700 px-2 py-1 rounded font-bold">À JOUR</span>
                )}
              </div>

              <div className="text-xs text-slate-600 mb-3 pb-3 border-b border-slate-100">
                {new Date(f.checkInDate).toLocaleDateString('fr-FR')} → {new Date(f.checkOutDate).toLocaleDateString('fr-FR')}
              </div>

              <div className="space-y-1.5 mb-3">
                <div className="flex justify-between text-xs">
                  <span className="text-slate-500">Chambre ({f.nights} nuit{f.nights > 1 ? 's' : ''})</span>
                  <span className="font-bold text-slate-900">{f.roomTotal?.toLocaleString('fr-FR')} Ar</span>
                </div>
                <div className="flex justify-between text-xs">
                  <span className="text-slate-500">Extras</span>
                  <span className="font-bold text-slate-900">{f.extrasTotal?.toLocaleString('fr-FR')} Ar</span>
                </div>
                {f.pendingTotal > 0 && (
                  <div className="flex justify-between text-xs">
                    <span className="text-amber-700">Commandes en attente</span>
                    <span className="font-bold text-amber-700">{f.pendingTotal.toLocaleString('fr-FR')} Ar</span>
                  </div>
                )}
                <div className="flex justify-between text-xs pt-1.5 border-t border-slate-200">
                  <span className="font-bold text-slate-700">Total séjour</span>
                  <span className="font-black text-slate-900">{f.grandTotal?.toLocaleString('fr-FR')} Ar</span>
                </div>
                <div className="flex justify-between text-xs">
                  <span className="text-slate-500">Déjà payé</span>
                  <span className="font-bold text-green-700">{f.paidAmount?.toLocaleString('fr-FR')} Ar</span>
                </div>
              </div>

              <div className={`flex justify-between items-baseline pt-3 border-t-2 ${f.solde > 0 ? 'border-red-200' : 'border-green-200'}`}>
                <span className="font-black text-xs uppercase tracking-wider text-slate-600">Reste à payer</span>
                <span className={`text-lg font-black ${f.solde > 0 ? 'text-red-600' : 'text-green-600'}`}>
                  {f.solde.toLocaleString('fr-FR')} Ar
                </span>
              </div>
            </button>
          ))}
        </div>
      )}

      {/* Modal détail folio */}
      {selected && !showPayment && !showCheckout && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4">
          <div className="absolute inset-0 bg-slate-900/80" onClick={() => setSelected(null)}></div>
          <div className="relative bg-white rounded-3xl shadow-2xl w-full max-w-3xl max-h-[92vh] overflow-hidden flex flex-col">
            <div className="bg-linear-to-r from-amber-500 to-orange-600 px-6 py-5 text-white">
              <div className="flex items-center justify-between">
                <div>
                  <div className="text-xs font-mono opacity-80">#{selected.reference}</div>
                  <h2 className="text-2xl font-black mt-0.5">Chambre {selected.room?.number}</h2>
                  <p className="text-sm opacity-90">
                    {selected.customer?.firstName} {selected.customer?.lastName}
                  </p>
                </div>
                <button
                  onClick={() => setSelected(null)}
                  className="w-10 h-10 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center text-xl font-bold"
                >
                  ✕
                </button>
              </div>
            </div>

            <div className="flex-1 overflow-y-auto p-6 space-y-4 bg-slate-50">
              {/* Actions */}
              <div className="space-y-2">
                <div className="flex gap-2">
                  <button
                    onClick={() => setShowAddCharge(true)}
                    className="flex-1 bg-white border-2 border-teal-300 text-teal-700 py-2.5 rounded-xl font-bold text-sm hover:bg-teal-50 transition"
                  >
                    + Ajouter un extra
                  </button>
                  {selected.solde > 0 && (
                    <button
                      onClick={() => {
                        setShowPayment(true);
                        setPayAmount(selected.solde.toString());
                      }}
                      className="flex-1 bg-green-600 hover:bg-green-700 text-white py-2.5 rounded-xl font-bold text-sm transition"
                    >
                      💳 Encaisser {selected.solde.toLocaleString('fr-FR')} Ar
                    </button>
                  )}
                </div>
                <button
                  onClick={() => {
                    setShowCheckout(true);
                    setPayAmount(selected.solde.toString());
                  }}
                  className="w-full bg-linear-to-r from-red-500 to-rose-600 hover:from-red-600 hover:to-rose-700 text-white py-3 rounded-xl font-black text-sm shadow-lg transition flex items-center justify-center gap-2"
                >
                  🚪 Clôturer le séjour et libérer la chambre
                </button>
              </div>

              {/* Extras */}
              <div>
                <h3 className="text-xs font-black text-slate-600 uppercase tracking-wider mb-2">
                  Extras folio ({selected.charges?.length || 0})
                </h3>
                <div className="space-y-2">
                  {(selected.charges || []).map((c: any) => (
                    <div key={c.id} className="flex items-center gap-3 bg-white rounded-xl border border-slate-200 p-3">
                      <div className="flex-1 min-w-0">
                        <div className="font-bold text-slate-900 text-sm truncate">{c.description}</div>
                        <div className="text-[10px] text-slate-500 font-medium">
                          {c.category} • {c.quantity} × {c.unitPrice.toLocaleString('fr-FR')} Ar
                        </div>
                      </div>
                      <div className="font-black text-slate-900">{c.total.toLocaleString('fr-FR')} Ar</div>
                      <button
                        onClick={() => removeCharge(c.id)}
                        className="text-red-500 hover:bg-red-50 p-1.5 rounded-lg transition text-xs font-bold"
                      >
                        ✕
                      </button>
                    </div>
                  ))}
                  {(selected.charges || []).length === 0 && (
                    <p className="text-center text-slate-400 text-xs py-4">Aucun extra pour le moment</p>
                  )}
                </div>
              </div>

              {/* Commandes en attente */}
              {(selected.pendingOrders || []).length > 0 && (
                <div>
                  <h3 className="text-xs font-black text-amber-700 uppercase tracking-wider mb-2">
                    Commandes en attente ({selected.pendingOrders.length})
                  </h3>
                  <div className="space-y-2">
                    {selected.pendingOrders.map((o: any) => (
                      <div key={o.id} className="bg-amber-50 border border-amber-200 rounded-xl p-3">
                        <div className="flex items-start justify-between mb-2">
                          <div className="text-xs font-bold text-amber-900">
                            Commande #{o.id.slice(-4).toUpperCase()} •{' '}
                            {new Date(o.createdAt).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}
                          </div>
                          <div className="font-black text-amber-900">
                            {(o.total - o.paidAmount).toLocaleString('fr-FR')} Ar
                          </div>
                        </div>
                        <div className="text-[11px] text-amber-800">
                          {o.items.map((it: any) => `${it.quantity}× ${it.menuItem.name}`).join(', ')}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {/* Récap totaux */}
              <div className="bg-linear-to-br from-slate-900 to-blue-900 rounded-2xl p-6 text-white">
                <div className="flex justify-between items-baseline pb-3 border-b border-white/20">
                  <span className="text-sm text-blue-200 font-bold uppercase">
                    Chambre ({selected.nights} nuit{selected.nights > 1 ? 's' : ''})
                  </span>
                  <span className="text-lg font-bold">{(selected.roomTotal || 0).toLocaleString('fr-FR')} Ar</span>
                </div>
                <div className="flex justify-between items-baseline py-3 border-b border-white/20">
                  <span className="text-sm text-blue-200 font-bold uppercase">Extras</span>
                  <span className="text-lg font-bold">{(selected.extrasTotal || 0).toLocaleString('fr-FR')} Ar</span>
                </div>
                <div className="flex justify-between items-baseline py-3 border-b border-white/20">
                  <span className="text-sm text-blue-200 font-bold uppercase">Total séjour</span>
                  <span className="text-2xl font-black">{(selected.grandTotal || 0).toLocaleString('fr-FR')} Ar</span>
                </div>
                <div className="flex justify-between items-baseline pt-3 text-green-300">
                  <span className="text-sm font-medium">Déjà payé</span>
                  <span className="text-xl font-bold">{(selected.paidAmount || 0).toLocaleString('fr-FR')} Ar</span>
                </div>
                <div className="flex justify-between items-baseline pt-3 mt-3 border-t-2 border-white/30">
                  <span className="font-black text-sm uppercase tracking-wider text-blue-200">Reste à payer</span>
                  <span className={`text-4xl font-black ${selected.solde > 0 ? 'text-red-400' : 'text-green-400'}`}>
                    {selected.solde.toLocaleString('fr-FR')}
                    <span className="text-lg ml-1">Ar</span>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Modal ajout extra */}
      {showAddCharge && selected && (
        <div className="fixed inset-0 z-60 flex items-center justify-center p-4">
          <div className="absolute inset-0 bg-slate-900/80" onClick={() => setShowAddCharge(false)}></div>
          <div className="relative bg-white rounded-2xl shadow-2xl w-full max-w-md p-5">
            <h3 className="text-lg font-bold text-slate-900 mb-4">Ajouter un extra au folio</h3>
            <form onSubmit={addCharge} className="space-y-3">
              <div>
                <label className="text-xs font-black text-slate-700 uppercase tracking-wider mb-2 block">Description</label>
                <input
                  type="text"
                  value={description}
                  onChange={(e) => setDescription(e.target.value)}
                  className="w-full px-4 py-3 bg-white border-2 border-slate-300 rounded-xl text-sm font-medium text-slate-900 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                  required
                />
              </div>
              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-xs font-black text-slate-700 uppercase tracking-wider mb-2 block">Catégorie</label>
                  <select
                    value={category}
                    onChange={(e) => setCategory(e.target.value)}
                    className="w-full px-4 py-3 bg-white border-2 border-slate-300 rounded-xl text-sm font-medium text-slate-900"
                  >
                    <option value="RESTAURANT">Restaurant</option>
                    <option value="MINIBAR">Minibar</option>
                    <option value="SPA">Spa</option>
                    <option value="LAUNDRY">Blanchisserie</option>
                    <option value="TRANSPORT">Transport</option>
                    <option value="OTHER">Autre</option>
                  </select>
                </div>
                <div>
                  <label className="text-xs font-black text-slate-700 uppercase tracking-wider mb-2 block">Quantité</label>
                  <input
                    type="number"
                    min="1"
                    value={quantity}
                    onChange={(e) => setQuantity(e.target.value)}
                    className="w-full px-4 py-3 bg-white border-2 border-slate-300 rounded-xl text-sm font-medium text-slate-900"
                  />
                </div>
              </div>
              <div>
                <label className="text-xs font-black text-slate-700 uppercase tracking-wider mb-2 block">Prix unitaire (Ar)</label>
                <input
                  type="number"
                  value={unitPrice}
                  onChange={(e) => setUnitPrice(e.target.value)}
                  className="w-full px-4 py-3 bg-white border-2 border-slate-300 rounded-xl text-sm font-medium text-slate-900"
                  required
                />
              </div>
              <div className="flex gap-2 pt-2">
                <button
                  type="button"
                  onClick={() => setShowAddCharge(false)}
                  className="px-5 py-3 bg-white border-2 border-slate-300 rounded-xl font-bold text-sm text-slate-900 hover:bg-slate-100 transition"
                >
                  Annuler
                </button>
                <button
                  type="submit"
                  className="flex-1 bg-teal-600 hover:bg-teal-700 text-white py-3 rounded-xl font-bold transition"
                >
                  Ajouter
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Modal paiement (partiel) */}
      {showPayment && selected && (
        <div className="fixed inset-0 z-60 flex items-center justify-center p-4">
          <div className="absolute inset-0 bg-slate-900/80" onClick={() => setShowPayment(false)}></div>
          <div className="relative bg-white rounded-2xl shadow-2xl w-full max-w-md p-6">
            <h3 className="text-xl font-black text-slate-900 mb-1">Encaissement folio</h3>
            <p className="text-sm font-medium text-slate-700 mb-4">
              Chambre {selected.room?.number} • {selected.customer?.firstName} {selected.customer?.lastName}
            </p>

            <div className="mb-4">
              <p className="text-xs font-black text-slate-700 uppercase tracking-wider mb-2">Solde à payer</p>
              <p className="text-3xl font-black text-slate-900">{selected.solde.toLocaleString('fr-FR')} Ar</p>
            </div>

            <form onSubmit={closeFolio} className="space-y-3">
              <div>
                <label className="text-xs font-black text-slate-700 uppercase tracking-wider mb-2 block">Montant encaissé</label>
                <input
                  type="number"
                  value={payAmount}
                  onChange={(e) => setPayAmount(e.target.value)}
                  className="w-full px-5 py-4 bg-white border-2 border-green-400 rounded-xl font-black text-3xl text-slate-900 focus:ring-2 focus:ring-green-500 focus:border-green-500"
                />
              </div>
              <div>
                <label className="text-xs font-black text-slate-700 uppercase tracking-wider mb-2 block">Mode de paiement</label>
                <div className="grid grid-cols-3 gap-2">
                  {[
                    { id: 'CASH', l: 'Espèces' },
                    { id: 'CARD', l: 'Carte' },
                    { id: 'MOBILE', l: 'Mobile' },
                  ].map((m) => (
                    <button
                      key={m.id}
                      type="button"
                      onClick={() => setPayMethod(m.id)}
                      className={`py-2.5 rounded-lg text-sm font-bold border-2 transition ${
                        payMethod === m.id
                          ? 'bg-slate-900 text-white border-slate-900 shadow-md'
                          : 'bg-white text-slate-800 border-slate-300 hover:border-slate-400 hover:bg-slate-50'
                      }`}
                    >
                      {m.l}
                    </button>
                  ))}
                </div>
              </div>
              <div className="flex gap-2 pt-2">
                <button
                  type="button"
                  onClick={() => setShowPayment(false)}
                  className="px-5 py-3 bg-white border-2 border-slate-300 rounded-xl font-bold text-sm text-slate-900 hover:bg-slate-100 transition"
                >
                  Annuler
                </button>
                <button
                  type="submit"
                  className="flex-1 bg-green-600 hover:bg-green-700 text-white py-3 rounded-xl font-bold transition"
                >
                  Valider
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Modal clôture séjour */}
      {showCheckout && selected && (
        <div className="fixed inset-0 z-70 flex items-center justify-center p-4">
          <div className="absolute inset-0 bg-slate-900/85" onClick={() => setShowCheckout(false)}></div>
          <div className="relative bg-white rounded-2xl shadow-2xl w-full max-w-md p-6">
            <div className="text-center mb-5">
              <div className="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center text-3xl mx-auto mb-3">
                🚪
              </div>
              <h3 className="text-xl font-black text-slate-900">Clôturer le séjour</h3>
              <p className="text-sm font-medium text-slate-700 mt-1">
                Chambre {selected.room?.number} • {selected.customer?.firstName} {selected.customer?.lastName}
              </p>
            </div>

            <div className="bg-slate-50 rounded-xl p-4 mb-4 space-y-2">
              <div className="flex justify-between text-sm">
                <span className="text-slate-600">
                  Chambre ({selected.nights} nuit{selected.nights > 1 ? 's' : ''})
                </span>
                <span className="font-bold">{selected.roomTotal.toLocaleString('fr-FR')} Ar</span>
              </div>
              <div className="flex justify-between text-sm">
                <span className="text-slate-600">Extras</span>
                <span className="font-bold">{selected.extrasTotal.toLocaleString('fr-FR')} Ar</span>
              </div>
              <div className="flex justify-between text-sm pt-2 border-t border-slate-200">
                <span className="font-bold text-slate-800">Total séjour</span>
                <span className="font-black text-slate-900">
                  {selected.grandTotal.toLocaleString('fr-FR')} Ar
                </span>
              </div>
              <div className="flex justify-between text-sm">
                <span className="text-green-700">Déjà payé</span>
                <span className="font-bold text-green-700">
                  {selected.paidAmount.toLocaleString('fr-FR')} Ar
                </span>
              </div>
              <div className="flex justify-between pt-2 border-t-2 border-slate-300">
                <span className="font-black text-slate-900">Solde à payer</span>
                <span
                  className={`font-black text-xl ${
                    selected.solde > 0 ? 'text-red-600' : 'text-green-600'
                  }`}
                >
                  {selected.solde.toLocaleString('fr-FR')} Ar
                </span>
              </div>
            </div>

            <form onSubmit={checkoutFolio} className="space-y-3">
              {selected.solde > 0 && (
                <div>
                  <label className="text-xs font-black text-slate-700 uppercase tracking-wider mb-2 block">
                    Mode de paiement du solde
                  </label>
                  <div className="grid grid-cols-3 gap-2">
                    {[
                      { id: 'CASH', l: 'Espèces' },
                      { id: 'CARD', l: 'Carte' },
                      { id: 'MOBILE', l: 'Mobile' },
                    ].map((m) => (
                      <button
                        key={m.id}
                        type="button"
                        onClick={() => setPayMethod(m.id)}
                        className={`py-2.5 rounded-lg text-sm font-bold border-2 transition ${
                          payMethod === m.id
                            ? 'bg-slate-900 text-white border-slate-900 shadow-md'
                            : 'bg-white text-slate-800 border-slate-300 hover:border-slate-400'
                        }`}
                      >
                        {m.l}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <div className="flex gap-2 pt-2">
                <button
                  type="button"
                  onClick={() => setShowCheckout(false)}
                  className="px-5 py-3 bg-white border-2 border-slate-300 rounded-xl font-bold text-sm text-slate-900 hover:bg-slate-100 transition"
                >
                  Annuler
                </button>
                <button
                  type="submit"
                  className="flex-1 bg-linear-to-r from-red-500 to-rose-600 hover:from-red-600 hover:to-rose-700 text-white py-3 rounded-xl font-black text-sm shadow-lg transition"
                >
                  ✓ Confirmer la clôture
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
