generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  COMMERCIAL
  FINANCE
  RH
  STOCK_MANAGER
  IT_TECH
  RECEPTION
  AUDITOR
  USER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_ORDER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        String?
  city        String?
  email       String?
  phone       String?
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches      Branch[]
  users         User[]
  customers     Customer[]
  modules       Module[]
  catalogItems  CatalogItem[]
  saleRecords   Sale[]
  tickets       Ticket[]
  employees     Employee[]
  documents     Document[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]
  payments      Payment[]
  storageQuota  StorageQuota?
  backups       Backup[]
  roomTypes     RoomType[]
  rooms         Room[]
  reservations  Reservation[]

  housekeepingTasks  HousekeepingTask[]
  folioCharges       FolioCharge[]
  menuItems          MenuItem[]
  restaurantOrders   RestaurantOrder[]
  maintenanceTickets MaintenanceTicket[]
  posSales           PosSale[]
  tables             Table[]
  cashRegisters      CashRegister[]
  cashMovements      CashMovement[]
  cashSessions       CashSession[]
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         SubscriptionStatus @default(TRIAL)
  startDate      DateTime           @default(now())
  endDate        DateTime?
  billingPeriod  String             @default("MONTHLY")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  activeModules SubscriptionModule[]
  payments      Payment[]
}

model SubscriptionModule {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  moduleId       String
  module         Module       @relation(fields: [moduleId], references: [id])
  isActive       Boolean      @default(true)
  activatedAt    DateTime     @default(now())
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amount         Float
  method         String
  reference      String?
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  date           DateTime      @default(now())
  status         String        @default("PAID")
  note           String?
}

model StorageQuota {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  usedStorage    Float        @default(0)
  maxStorage     Float        @default(500)
  lastBackup     DateTime?
}

model Backup {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileName       String       @default("backup.sql")
  fileSize       Float        @default(0)
  status         String       @default("COMPLETED")
  createdAt      DateTime     @default(now())

  @@map("Backup")
}

model Branch {
  id             String       @id @default(cuid())
  name           String
  city           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  createdAt      DateTime     @default(now())
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  password       String
  name           String?
  role           Role             @default(USER)
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  branchId       String?
  branch         Branch?          @relation(fields: [branchId], references: [id])
  isActive       Boolean          @default(true)
  isOwner        Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  permissions    UserPermission[]
  auditLogs      AuditLog[]
  tickets        Ticket[]         @relation("AssignedTickets")
  documents      Document[]
  customers      Customer[]
  customerNotes  CustomerNote[]

  housekeepingTasks   HousekeepingTask[]  @relation("HousekeepingAssigned")
  maintenanceAssigned MaintenanceTicket[] @relation("MaintenanceAssigned")
  cashMovements       CashMovement[]
  cashSessions        CashSession[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  users       UserPermission[]
}

model UserPermission {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model Customer {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  address        String?
  city           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  tags           String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  saleRecords  Sale[]
  reservations Reservation[]
  notes        CustomerNote[]
  documents    CustomerDocument[]
  posSales     PosSale[]
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content    String
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())
}

model CustomerDocument {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  url        String
  type       String?
  size       Int?
  createdAt  DateTime @default(now())
}

model Module {
  id             String       @id @default(cuid())
  name           String
  types          String?
  description    String?
  price          Float        @default(0)
  pricing        Json?
  status         String       @default("ACTIVE")
  route          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subscriptionModules SubscriptionModule[]
  saleRecords         Sale[]
}

model CatalogItem {
  id             String       @id @default(cuid())
  name           String
  description    String?
  price          Float
  category       String?
  stock          Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  saleRecords    Sale[]
}

model Sale {
  id             String       @id @default(cuid())
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  moduleId       String?
  module         Module?      @relation(fields: [moduleId], references: [id])
  catalogItemId  String?
  catalogItem    CatalogItem? @relation(fields: [catalogItemId], references: [id])
  quantity       Int          @default(1)
  total          Float
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model Ticket {
  id             String       @id @default(cuid())
  title          String
  description    String?
  status         String       @default("OPEN")
  priority       String       @default("NORMAL")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedToId   String?
  assignedTo     User?        @relation("AssignedTickets", fields: [assignedToId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Employee {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  position       String?
  department     String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model Document {
  id             String       @id @default(cuid())
  name           String
  url            String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          User?        @relation(fields: [ownerId], references: [id])
  createdAt      DateTime     @default(now())
}

model AuditLog {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  action         String
  entity         String?
  entityId       String?
  oldValue       String?
  newValue       String?
  ipAddress      String?
  createdAt      DateTime      @default(now())
}

// ============================================
// MODULE HOTEL / RESERVATION
// ============================================

model RoomType {
  id             String       @id @default(cuid())
  name           String
  description    String?
  capacity       Int          @default(1)
  basePrice      Float        @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooms          Room[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Room {
  id             String              @id @default(cuid())
  number         String
  floor          Int?
  status         RoomStatus          @default(AVAILABLE)
  notes          String?
  roomTypeId     String
  roomType       RoomType            @relation(fields: [roomTypeId], references: [id])
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations   Reservation[]
  housekeeping   HousekeepingTask[]
  maintenance    MaintenanceTicket[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, number])
}

model Reservation {
  id               String            @id @default(cuid())
  reference        String            @unique
  checkInDate      DateTime
  checkOutDate     DateTime
  adults           Int               @default(1)
  children         Int               @default(0)
  status           ReservationStatus @default(PENDING)
  totalAmount      Float             @default(0)
  paidAmount       Float             @default(0)
  notes            String?
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id])
  roomId           String
  room             Room              @relation(fields: [roomId], references: [id])
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkedInAt      DateTime?
  checkedOutAt     DateTime?
  folioCharges     FolioCharge[]
  restaurantOrders RestaurantOrder[]
  posSales         PosSale[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// ============================================
// MODULE HOTEL — EXTENSIONS
// ============================================

model HousekeepingTask {
  id             String       @id @default(cuid())
  roomId         String
  room           Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedToId   String?
  assignedTo     User?        @relation("HousekeepingAssigned", fields: [assignedToId], references: [id])
  status         String       @default("PENDING")
  priority       String       @default("NORMAL")
  notes          String?
  dueDate        DateTime?
  completedAt    DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("HousekeepingTask")
}

model FolioCharge {
  id             String       @id @default(cuid())
  reservationId  String
  reservation    Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  description    String
  category       String       @default("OTHER")
  quantity       Int          @default(1)
  unitPrice      Float
  total          Float
  date           DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@map("FolioCharge")
}

model MenuItem {
  id             String                @id @default(cuid())
  name           String
  description    String?
  category       String?
  price          Float
  isAvailable    Boolean               @default(true)
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderItems     RestaurantOrderItem[]
  posSaleItems   PosSaleItem[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@map("MenuItem")
}

model RestaurantOrder {
  id             String                @id @default(cuid())
  reservationId  String?
  reservation    Reservation?          @relation(fields: [reservationId], references: [id])
  tableId        String?
  table          Table?                @relation(fields: [tableId], references: [id])
  roomNumber     String?
  guestCount     Int                   @default(1)
  status         String                @default("PENDING")
  total          Float                 @default(0)
  paidAmount     Float                 @default(0)
  paymentStatus  String                @default("UNPAID")
  notes          String?
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          RestaurantOrderItem[]
  payments       OrderPayment[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@map("RestaurantOrder")
}

model RestaurantOrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem        @relation(fields: [menuItemId], references: [id])
  quantity   Int             @default(1)
  unitPrice  Float
  total      Float

  @@map("RestaurantOrderItem")
}

model MaintenanceTicket {
  id             String       @id @default(cuid())
  roomId         String?
  room           Room?        @relation(fields: [roomId], references: [id])
  title          String
  description    String?
  priority       String       @default("NORMAL")
  status         String       @default("OPEN")
  assignedToId   String?
  assignedTo     User?        @relation("MaintenanceAssigned", fields: [assignedToId], references: [id])
  resolvedAt     DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("MaintenanceTicket")
}

// ============================================
// MODULE CAISSE / POS
// ============================================

model PosSale {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservationId  String?
  reservation    Reservation?  @relation(fields: [reservationId], references: [id])
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  total          Float         @default(0)
  paymentMethod  String        @default("CASH")
  status         String        @default("PAID")
  notes          String?
  items          PosSaleItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("PosSale")
}

model PosSaleItem {
  id         String   @id @default(cuid())
  saleId     String
  sale       PosSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)
  unitPrice  Float
  total      Float

  @@map("PosSaleItem")
}

// ============================================
// MODULE TABLES & PAIEMENTS RESTAURANT
// ============================================

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  CLEANING
}

model Table {
  id             String            @id @default(cuid())
  number         String
  location       String            @default("RESTAURANT")
  capacity       Int               @default(2)
  status         TableStatus       @default(FREE)
  notes          String?
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders         RestaurantOrder[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, number])
  @@map("Table")
}

model OrderPayment {
  id            String       @id @default(cuid())
  orderId       String
  order         RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])
  amount        Float
  method        String
  notes     String?
  createdAt DateTime        @default(now())

  @@index([cashSessionId])
  @@map("OrderPayment")
}

// ══════════════════════════════════════════════
// JOURNAL DE CAISSE
// ══════════════════════════════════════════════

model CashRegister {
  id             String         @id @default(cuid())
  name           String
  type           String         @default("CAISSE")
  location       String?
  currentBalance Float          @default(0)
  status         String         @default("CLOSED")
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements      CashMovement[]
  sessions       CashSession[]
  openedAt       DateTime?
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("CashRegister")
}

model CashMovement {
  id             String       @id @default(cuid())
  registerId     String
  register       CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        CashSession? @relation(fields: [sessionId], references: [id])
  type           String
  amount         Float
  reason         String?
  reference      String?
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([sessionId])
  @@map("CashMovement")
}

model CashSession {
  id                String       @id @default(cuid())
  registerId        String
  register          CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  openingAmount     Float        @default(0)
  closingAmount     Float?
  theoreticalAmount Float?
  difference        Float?
  openedAt          DateTime     @default(now())
  closedAt          DateTime?
  userId            String?
  user              User?        @relation(fields: [userId], references: [id])
  movements         CashMovement[]
  orderPayments     OrderPayment[]
  notes             String?
  openingBreakdown  Json?
  closingBreakdown  Json?
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("CashSession")
}
