import { Injectable, NotFoundException, BadRequestException, ForbiddenException } from '@nestjs/common';
import { PrismaService } from '../prisma.service';

@Injectable()
export class PosService {
  constructor(private prisma: PrismaService) {}

  private async getOrganizationId(user: any): Promise<string> {
    if (user.organizationId) return user.organizationId;
    throw new ForbiddenException("Réservé aux utilisateurs d'une organisation.");
  }

  private canWrite(user: any): boolean {
    return (user.role === 'SUPER_ADMIN' && user.isOwner) ||
      ['ADMIN', 'MANAGER', 'COMMERCIAL', 'RECEPTION', 'STOCK_MANAGER'].includes(user.role);
  }

  // ═══════════════════════════════════════════════
  // MENU
  // ═══════════════════════════════════════════════
  async findAllMenu(user: any, category?: string) {
    const orgId = await this.getOrganizationId(user);
    return this.prisma.menuItem.findMany({
      where: { organizationId: orgId, ...(category ? { category } : {}) },
      orderBy: [{ category: 'asc' }, { name: 'asc' }],
    });
  }

  async createMenuItem(user: any, data: any) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    const orgId = await this.getOrganizationId(user);
    return this.prisma.menuItem.create({
      data: { name: data.name, description: data.description || null, category: data.category || 'OTHER',
        price: parseFloat(data.price) || 0, isAvailable: data.isAvailable !== false, organizationId: orgId },
    });
  }

  async updateMenuItem(user: any, id: string, data: any) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    return this.prisma.menuItem.update({ where: { id }, data: {
      name: data.name ?? undefined, description: data.description ?? undefined,
      category: data.category ?? undefined, price: data.price !== undefined ? parseFloat(data.price) : undefined,
      isAvailable: data.isAvailable ?? undefined,
    }});
  }

  async removeMenuItem(user: any, id: string) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    return this.prisma.menuItem.delete({ where: { id } });
  }

  // ═══════════════════════════════════════════════
  // TABLES
  // ═══════════════════════════════════════════════
  async findAllTables(user: any) {
    const orgId = await this.getOrganizationId(user);
    return this.prisma.table.findMany({ where: { organizationId: orgId }, orderBy: [{ location: 'asc' }, { number: 'asc' }] });
  }

  async createTable(user: any, data: any) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    const orgId = await this.getOrganizationId(user);
    const existing = await this.prisma.table.findFirst({ where: { organizationId: orgId, number: data.number } });
    if (existing) throw new BadRequestException(`La table ${data.number} existe déjà.`);
    return this.prisma.table.create({ data: { number: data.number, location: data.location || 'RESTAURANT',
      capacity: data.capacity || 2, status: data.status || 'FREE', notes: data.notes || null, organizationId: orgId }});
  }

  async updateTable(user: any, id: string, data: any) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    return this.prisma.table.update({ where: { id }, data: {
      number: data.number ?? undefined, location: data.location ?? undefined, capacity: data.capacity ?? undefined,
      status: data.status ?? undefined, notes: data.notes ?? undefined,
    }});
  }

  async removeTable(user: any, id: string) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    return this.prisma.table.delete({ where: { id } });
  }

  // ═══════════════════════════════════════════════
  // ORDERS — Flux complet
  // ═══════════════════════════════════════════════

  /** Liste des commandes actives (non payées) */
  async findActiveOrders(user: any) {
    const orgId = await this.getOrganizationId(user);
    return this.prisma.restaurantOrder.findMany({
      where: {
        organizationId: orgId,
        paymentStatus: { in: ['UNPAID', 'PARTIAL'] },
        status: { notIn: ['CANCELLED'] },
        OR: [
          { notes: null },
          { notes: '' },
          { NOT: { notes: { contains: 'CREDIT' } } },
        ],
      },
      include: {
        items: { include: { menuItem: true } },
        table: true,
        reservation: { include: { customer: true, room: true } },
      },
      orderBy: { createdAt: 'asc' },
    });
  }

  /** Toutes les commandes (historique) */
  async findAllOrders(user: any, status?: string) {
    const orgId = await this.getOrganizationId(user);
    return this.prisma.restaurantOrder.findMany({
      where: { organizationId: orgId, ...(status ? { status } : {}) },
      include: {
        items: { include: { menuItem: true } },
        table: true,
        reservation: { include: { customer: true, room: true } },
        payments: { orderBy: { createdAt: 'desc' } },
      },
      orderBy: { createdAt: 'desc' }, take: 100,
    });
  }

  /** Détail d'une commande */
  async findOneOrder(user: any, id: string) {
    const orgId = await this.getOrganizationId(user);
    const order = await this.prisma.restaurantOrder.findFirst({
      where: { id, organizationId: orgId },
      include: {
        items: { include: { menuItem: true } },
        table: true,
        reservation: { include: { customer: true, room: true } },
        payments: { orderBy: { createdAt: 'desc' } },
      },
    });
    if (!order) throw new NotFoundException('Commande introuvable');
    return order;
  }

  /** Créer une commande (avant paiement) */
  async createOrder(user: any, data: any) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    const orgId = await this.getOrganizationId(user);

    const items = data.items || [];
    if (items.length === 0) throw new BadRequestException('Aucun article');

    let total = 0;
    const itemsToCreate: any[] = [];
    for (const it of items) {
      const menuItem = await this.prisma.menuItem.findUnique({ where: { id: it.menuItemId } });
      if (!menuItem) throw new NotFoundException(`Produit introuvable`);
      const qty = parseInt(it.quantity) || 1;
      const lineTotal = qty * menuItem.price;
      total += lineTotal;
      itemsToCreate.push({ menuItemId: it.menuItemId, quantity: qty, unitPrice: menuItem.price, total: lineTotal });
    }

    const order = await this.prisma.restaurantOrder.create({
      data: {
        tableId: data.tableId || null,
        reservationId: data.reservationId || null,
        roomNumber: data.roomNumber || null,
        guestCount: data.guestCount || 1,
        status: data.serviceType === 'DINE_IN' ? 'PENDING' : 'SERVED',
        total,
        paidAmount: 0,
        paymentStatus: 'UNPAID',
        notes: data.notes || null,
        organizationId: orgId,
        items: { create: itemsToCreate },
      },
      include: { items: { include: { menuItem: true } }, table: true },
    });

    // Marquer la table occupée
    if (data.tableId) {
      await this.prisma.table.update({ where: { id: data.tableId }, data: { status: 'OCCUPIED' } });
    }

    return order;
  }

  /** Ajouter des articles à une commande existante */
  async addItemsToOrder(user: any, orderId: string, items: any[]) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    const orgId = await this.getOrganizationId(user);
    const order = await this.prisma.restaurantOrder.findFirst({ where: { id: orderId, organizationId: orgId } });
    if (!order) throw new NotFoundException('Commande introuvable');
    if (order.paymentStatus === 'PAID') throw new BadRequestException('Commande déjà payée');

    let added = 0;
    for (const it of items) {
      const mi = await this.prisma.menuItem.findUnique({ where: { id: it.menuItemId } });
      if (!mi) continue;
      const qty = parseInt(it.quantity) || 1;
      const lineTotal = qty * mi.price;
      added += lineTotal;
      await this.prisma.restaurantOrderItem.create({
        data: { orderId, menuItemId: it.menuItemId, quantity: qty, unitPrice: mi.price, total: lineTotal },
      });
    }

    return this.prisma.restaurantOrder.update({
      where: { id: orderId },
      data: { total: order.total + added },
      include: { items: { include: { menuItem: true } } },
    });
  }

  /** Modifier la quantité d'un item */
  async updateOrderItem(user: any, itemId: string, quantity: number) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    const item = await this.prisma.restaurantOrderItem.findUnique({ where: { id: itemId } });
    if (!item) throw new NotFoundException('Article introuvable');

    const newQty = Math.max(1, quantity);
    const newTotal = item.unitPrice * newQty;

    const updated = await this.prisma.restaurantOrderItem.update({
      where: { id: itemId }, data: { quantity: newQty, total: newTotal },
    });

    // Recalculer le total de la commande
    const items = await this.prisma.restaurantOrderItem.findMany({ where: { orderId: item.orderId } });
    const newOrderTotal = items.reduce((s, i) => s + i.total, 0);
    await this.prisma.restaurantOrder.update({ where: { id: item.orderId }, data: { total: newOrderTotal } });

    return updated;
  }

  async removeOrderItem(user: any, itemId: string) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    const item = await this.prisma.restaurantOrderItem.findUnique({ where: { id: itemId } });
    if (!item) throw new NotFoundException('Article introuvable');

    await this.prisma.restaurantOrderItem.delete({ where: { id: itemId } });

    const items = await this.prisma.restaurantOrderItem.findMany({ where: { orderId: item.orderId } });
    const newTotal = items.reduce((s, i) => s + i.total, 0);
    await this.prisma.restaurantOrder.update({ where: { id: item.orderId }, data: { total: newTotal } });

    return { success: true };
  }

  /** Envoyer en cuisine (PENDING → PREPARING) */
  async sendToKitchen(user: any, orderId: string) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    return this.prisma.restaurantOrder.update({ where: { id: orderId }, data: { status: 'PREPARING' } });
  }

  /** Marquer comme servi (PREPARING → SERVED) */
  async markServed(user: any, orderId: string) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    return this.prisma.restaurantOrder.update({ where: { id: orderId }, data: { status: 'SERVED' } });
  }

  /** Encaisser (partiel ou total) */
  async payOrder(user: any, orderId: string, data: any) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    const orgId = await this.getOrganizationId(user);
    const order = await this.prisma.restaurantOrder.findFirst({
      where: { id: orderId, organizationId: orgId }, include: { items: true },
    });
    if (!order) throw new NotFoundException('Commande introuvable');

    const amount = parseFloat(data.amount) || 0;
    if (amount <= 0) throw new BadRequestException('Montant invalide');

    const remaining = order.total - order.paidAmount;
    if (amount > remaining + 0.01) throw new BadRequestException(`Dépasse le reste dû (${remaining.toFixed(0)} Ar)`);

    await this.prisma.orderPayment.create({ data: {
      orderId, amount, method: data.method || 'CASH', notes: data.notes || null,
    }});

    const newPaid = order.paidAmount + amount;
    let paymentStatus = 'PARTIAL';
    if (newPaid >= order.total - 0.01) paymentStatus = 'PAID';

    const updated = await this.prisma.restaurantOrder.update({
      where: { id: orderId },
      data: { paidAmount: newPaid, paymentStatus, status: paymentStatus === 'PAID' ? 'PAID' : order.status },
      include: { items: true, payments: true },
    });

    // ═══ Auto-création mouvement caisse si paiement ESPÈCES ═══
    if (data.method === 'CASH' && amount > 0) {
      await this.recordCashSale(orgId, user, amount, updated.id);
    }

    return updated;
  }

  /**
   * Enregistre automatiquement une vente cash dans le journal de caisse.
   * Si aucune caisse n'est ouverte, crée ou utilise la caisse par défaut.
   */
  private async recordCashSale(orgId: string, user: any, amount: number, orderId: string) {
    try {
      // STRICT : seules les caisses OUVERTES acceptent des mouvements.
      // Si aucune caisse n est ouverte, on refuse silencieusement
      // (le paiement est encaisse mais pas journalise en caisse).
      const register = await this.prisma.cashRegister.findFirst({
        where: { organizationId: orgId, status: 'OPEN' },
        orderBy: { createdAt: 'asc' },
      });

      if (!register) {
        console.warn(
          `[recordCashSale] Aucune caisse OUVERTE - vente POS ${orderId.slice(-4).toUpperCase()} ${amount} Ar NON journalisee. Ouvrez une caisse puis saisissez un mouvement manuel.`,
        );
        return;
      }

      await this.prisma.$transaction(async (tx) => {
        await tx.cashMovement.create({
          data: {
            registerId: register.id,
            type: 'SALE',
            amount,
            reason: `Vente POS ${orderId.slice(-4).toUpperCase()}`,
            reference: orderId,
            userId: user.userId || user.id,
            organizationId: orgId,
          },
        });

        await tx.cashRegister.update({
          where: { id: register.id },
          data: { currentBalance: { increment: amount } },
        });
      });
    } catch (err) {
      console.error('[recordCashSale] Erreur:', err);
    }
  }

  /** Annuler une commande */
  async cancelOrder(user: any, orderId: string, reason?: string) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    const order = await this.prisma.restaurantOrder.findUnique({ where: { id: orderId } });
    if (!order) throw new NotFoundException('Commande introuvable');

    const cancelled = await this.prisma.restaurantOrder.update({
      where: { id: orderId },
      data: { status: 'CANCELLED', notes: reason ? `ANNULÉ: ${reason}` : order.notes },
    });

    if (order.tableId) {
      await this.prisma.table.update({ where: { id: order.tableId }, data: { status: 'FREE' } });
    }
    return cancelled;
  }

  /** Reporter en chambre (payer via folio) */
  async deferToRoom(user: any, orderId: string, reservationId: string) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    const orgId = await this.getOrganizationId(user);
    const order = await this.prisma.restaurantOrder.findFirst({
      where: { id: orderId, organizationId: orgId }, include: { items: { include: { menuItem: true } } },
    });
    if (!order) throw new NotFoundException('Commande introuvable');

    const reservation = await this.prisma.reservation.findFirst({ where: { id: reservationId, organizationId: orgId } });
    if (!reservation) throw new NotFoundException('Réservation introuvable');

    const remaining = order.total - order.paidAmount;
    if (remaining <= 0) throw new BadRequestException('Rien à reporter');

    // Créer les FolioCharge
    for (const it of order.items) {
      await this.prisma.folioCharge.create({ data: {
        reservationId, description: `Restaurant - ${it.menuItem.name}`, category: 'RESTAURANT',
        quantity: it.quantity, unitPrice: it.unitPrice, total: it.total, organizationId: orgId,
      }});
    }

    await this.prisma.orderPayment.create({ data: {
      orderId, amount: remaining, method: 'ROOM_CHARGE', notes: `Reporté résa ${reservation.reference}`,
    }});

    const updated = await this.prisma.restaurantOrder.update({
      where: { id: orderId },
      data: { paidAmount: order.total, paymentStatus: 'PAID', status: 'PAID', reservationId },
    });

    if (order.tableId) {
      await this.prisma.table.update({ where: { id: order.tableId }, data: { status: 'CLEANING' } });
    }
    return updated;
  }

  // ═══════════════════════════════════════════════
  // STATS
  // ═══════════════════════════════════════════════
  async getStats(user: any) {
    const orgId = await this.getOrganizationId(user);
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const [todayOrders, activeOrders, creditsCount, todayRevenue, cashTotal] = await Promise.all([
      this.prisma.restaurantOrder.count({
        where: { organizationId: orgId, createdAt: { gte: today } },
      }),
      this.prisma.restaurantOrder.count({
        where: {
          organizationId: orgId,
          paymentStatus: { in: ['UNPAID', 'PARTIAL'] },
          status: { notIn: ['CANCELLED'] },
          OR: [
            { notes: null },
            { notes: '' },
            { NOT: { notes: { contains: 'CREDIT' } } },
          ],
        },
      }),
      this.prisma.restaurantOrder.count({
        where: {
          organizationId: orgId,
          paymentStatus: { in: ['UNPAID', 'PARTIAL'] },
          status: { notIn: ['CANCELLED'] },
          notes: { contains: 'CREDIT' },
        },
      }),
      this.prisma.orderPayment.aggregate({
        where: { order: { organizationId: orgId }, createdAt: { gte: today } },
        _sum: { amount: true },
      }),
      this.prisma.orderPayment.aggregate({
        where: { order: { organizationId: orgId }, createdAt: { gte: today }, method: 'CASH' },
        _sum: { amount: true },
      }),
    ]);

    return {
      todayOrders,
      activeOrders,
      creditsCount,
      todayRevenue: todayRevenue._sum.amount || 0,
      cashToday: cashTotal._sum.amount || 0,
    };
  }

  // ═══════════════════════════════════════════
  // FOLIOS CLIENTS (chambres en séjour)
  // ═══════════════════════════════════════════
  async findAllFolios(user: any) {
    const orgId = await this.getOrganizationId(user);

    const reservations = await this.prisma.reservation.findMany({
      where: { organizationId: orgId, status: 'CHECKED_IN' },
      include: {
        customer: true,
        room: { include: { roomType: true } },
        folioCharges: { orderBy: { date: 'desc' } },
      },
      orderBy: { checkInDate: 'asc' },
    });

    const orders = await this.prisma.restaurantOrder.findMany({
      where: {
        organizationId: orgId,
        roomNumber: { not: null },
        paymentStatus: { in: ['UNPAID', 'PARTIAL'] },
        status: { notIn: ['CANCELLED'] },
      },
      include: { items: { include: { menuItem: true } }, reservation: true },
      orderBy: { createdAt: 'desc' },
    });

    return reservations.map((r) => {
      const charges = r.folioCharges || [];
      const extrasTotal = charges.reduce((s, c) => s + c.total, 0);

      // Chambre : nb nuits × prix type
      const nights = Math.max(1, Math.ceil(
        (new Date(r.checkOutDate).getTime() - new Date(r.checkInDate).getTime()) / (1000 * 60 * 60 * 24)
      ));
      const pricePerNight = r.room?.roomType?.basePrice || 0;
      const roomTotal = nights * pricePerNight;

      const pendingOrders = orders.filter((o) => o.reservationId === r.id);
      const pendingTotal = pendingOrders.reduce((s, o) => s + (o.total - o.paidAmount), 0);

      const grandTotal = roomTotal + extrasTotal + pendingTotal;
      const paidAmount = r.paidAmount || 0;

      return {
        reservationId: r.id,
        reference: r.reference,
        customer: r.customer,
        room: r.room,
        checkInDate: r.checkInDate,
        checkOutDate: r.checkOutDate,
        nights,
        pricePerNight,
        roomTotal,
        charges,
        pendingOrders: pendingOrders.map((o) => ({
          id: o.id, items: o.items, total: o.total, paidAmount: o.paidAmount,
          status: o.status, createdAt: o.createdAt,
        })),
        extrasTotal,
        pendingTotal,
        grandTotal,
        paidAmount,
        solde: grandTotal - paidAmount,
      };
    });
  }

  // Ajouter un extra directement au folio
  async addFolioCharge(user: any, reservationId: string, data: any) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    const orgId = await this.getOrganizationId(user);

    const reservation = await this.prisma.reservation.findFirst({
      where: { id: reservationId, organizationId: orgId },
    });
    if (!reservation) throw new NotFoundException('Réservation introuvable');

    const qty = parseInt(data.quantity) || 1;
    const unitPrice = parseFloat(data.unitPrice) || 0;

    return this.prisma.folioCharge.create({
      data: {
        reservationId,
        description: data.description,
        category: data.category || 'OTHER',
        quantity: qty,
        unitPrice,
        total: qty * unitPrice,
        organizationId: orgId,
      },
    });
  }

  // Supprimer un extra
  async removeFolioCharge(user: any, chargeId: string) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    return this.prisma.folioCharge.delete({ where: { id: chargeId } });
  }

  // Clôturer le folio (paiement complet)
  async closeFolio(user: any, reservationId: string, data: any) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    const orgId = await this.getOrganizationId(user);

    const reservation = await this.prisma.reservation.findFirst({
      where: { id: reservationId, organizationId: orgId },
      include: { folioCharges: true },
    });
    if (!reservation) throw new NotFoundException('Réservation introuvable');

    const extrasTotal = reservation.folioCharges.reduce((s, c) => s + c.total, 0);
    const amount = parseFloat(data.amount) || extrasTotal;

    // Créer un Payment
    await this.prisma.payment.create({
      data: {
        organizationId: orgId,
        amount,
        method: data.method || 'CASH',
        note: `Clôture folio ${reservation.reference}`,
        status: 'PAID',
      },
    });

    // Mettre à jour la résa
    return this.prisma.reservation.update({
      where: { id: reservationId },
      data: { paidAmount: reservation.paidAmount + amount },
    });
  }

  // ═══════════════════════════════════════════
  // VENTES À CRÉDIT
  // ═══════════════════════════════════════════
  async findAllCredits(user: any) {
    const orgId = await this.getOrganizationId(user);

    const orders = await this.prisma.restaurantOrder.findMany({
      where: {
        organizationId: orgId,
        paymentStatus: { in: ['UNPAID', 'PARTIAL'] },
        status: { notIn: ['CANCELLED'] },
        notes: { contains: 'CREDIT' },
      },
      include: {
        items: { include: { menuItem: true } },
        table: true,
        reservation: { include: { customer: true, room: true } },
        payments: { orderBy: { createdAt: 'desc' } },
      },
      orderBy: { createdAt: 'desc' },
    });

    return orders.map((o) => ({
      id: o.id,
      reference: '#' + o.id.slice(-4).toUpperCase(),
      total: o.total,
      paidAmount: o.paidAmount,
      remaining: o.total - o.paidAmount,
      status: o.paymentStatus,
      notes: o.notes,
      createdAt: o.createdAt,
      customer: o.reservation?.customer || null,
      room: o.reservation?.room?.number || null,
      table: o.table?.number || null,
      items: o.items,
      payments: o.payments,
    }));
  }

  async payCredit(user: any, orderId: string, data: any) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    const orgId = await this.getOrganizationId(user);

    const order = await this.prisma.restaurantOrder.findFirst({
      where: { id: orderId, organizationId: orgId },
    });
    if (!order) throw new NotFoundException('Commande introuvable');

    const amount = parseFloat(data.amount) || 0;
    if (amount <= 0) throw new BadRequestException('Montant invalide');

    const remaining = order.total - order.paidAmount;
    if (amount > remaining + 0.01) throw new BadRequestException('Dépasse le reste dû');

    await this.prisma.orderPayment.create({
      data: {
        orderId,
        amount,
        method: data.method || 'CASH',
        notes: 'Règlement crédit',
      },
    });

    const newPaid = order.paidAmount + amount;
    const paymentStatus = newPaid >= order.total - 0.01 ? 'PAID' : 'PARTIAL';

    return this.prisma.restaurantOrder.update({
      where: { id: orderId },
      data: { paidAmount: newPaid, paymentStatus },
      include: { items: true, payments: true },
    });
  }

  async getCreditsStats(user: any) {
    const orgId = await this.getOrganizationId(user);

    const [total, count] = await Promise.all([
      this.prisma.restaurantOrder.aggregate({
        where: {
          organizationId: orgId,
          paymentStatus: { in: ['UNPAID', 'PARTIAL'] },
          notes: { contains: 'CREDIT' },
          status: { notIn: ['CANCELLED'] },
        },
        _sum: { total: true, paidAmount: true },
      }),
      this.prisma.restaurantOrder.count({
        where: {
          organizationId: orgId,
          paymentStatus: { in: ['UNPAID', 'PARTIAL'] },
          notes: { contains: 'CREDIT' },
          status: { notIn: ['CANCELLED'] },
        },
      }),
    ]);

    const totalAmount = total._sum.total || 0;
    const paidAmount = total._sum.paidAmount || 0;

    return {
      totalCredits: totalAmount,
      totalPaid: paidAmount,
      totalRemaining: totalAmount - paidAmount,
      count,
    };
  }

  // Marquer une commande en CREDIT (sans paiement)
  async markAsCredit(user: any, orderId: string, data: any) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    const orgId = await this.getOrganizationId(user);

    const order = await this.prisma.restaurantOrder.findFirst({
      where: { id: orderId, organizationId: orgId },
    });
    if (!order) throw new NotFoundException('Commande introuvable');

    return this.prisma.restaurantOrder.update({
      where: { id: orderId },
      data: {
        paymentStatus: 'UNPAID',
        notes: order.notes ? order.notes + ' | CREDIT' : 'CREDIT',
      },
    });
  }

  // Clôturer le séjour : encaisser solde + check-out + libérer chambre
  async checkoutFolio(user: any, reservationId: string, data: any) {
    if (!this.canWrite(user)) throw new ForbiddenException('Accès refusé');
    const orgId = await this.getOrganizationId(user);

    const reservation = await this.prisma.reservation.findFirst({
      where: { id: reservationId, organizationId: orgId },
      include: { folioCharges: true, room: { include: { roomType: true } } },
    });
    if (!reservation) throw new NotFoundException('Réservation introuvable');

    const nights = Math.max(1, Math.ceil(
      (new Date(reservation.checkOutDate).getTime() - new Date(reservation.checkInDate).getTime()) / (1000 * 60 * 60 * 24)
    ));
    const roomTotal = nights * (reservation.room?.roomType?.basePrice || 0);
    const extrasTotal = reservation.folioCharges.reduce((s, c) => s + c.total, 0);
    const grandTotal = roomTotal + extrasTotal;
    const solde = grandTotal - reservation.paidAmount;

    // Encaisser le solde s'il reste quelque chose
    if (solde > 0 && data.method) {
      await this.prisma.payment.create({
        data: {
          organizationId: orgId,
          amount: solde,
          method: data.method,
          note: `Clôture séjour ${reservation.reference} (${nights} nuits + extras)`,
          status: 'PAID',
        },
      });
    }

    // Check-out : résa → CHECKED_OUT, chambre → CLEANING
    return this.prisma.$transaction(async (tx) => {
      await tx.reservation.update({
        where: { id: reservationId },
        data: {
          status: 'CHECKED_OUT',
          checkedOutAt: new Date(),
          paidAmount: reservation.paidAmount + Math.max(0, solde),
        },
      });
      await tx.room.update({
        where: { id: reservation.roomId },
        data: { status: 'CLEANING' },
      });
      return { success: true, soldePaid: Math.max(0, solde) };
    });
  }
}
